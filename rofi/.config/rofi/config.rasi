/* Rofi Configuration */
configuration {
    modi: "drun,run,window,filebrowser";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: " Apps";
    display-run: " Run";
    display-window: " Windows";
    display-filebrowser: " Files";
    drun-display-format: "{name}";
    window-format: "{w} {c} {t}";
    font: "JetBrains Mono 12";
    terminal: "kitty";
}

@theme "catppuccin"
