// niri — scrollable-tiling Wayland compositor (Rust, on Smithay).
// Alternative session to Hyprland: pick "niri" at the tuigreet menu after a
// logout. Hyprland stays the default (greetd initial_session). niri reloads
// this file live on save; `niri validate` checks it without a session.
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
//
// Ported from hypr/lua/*.lua. Deliberately NOT carried over (Hyprland-only):
// hyprsplit (niri workspaces are per-monitor natively), pyprland scratchpads,
// hyprshade, hyprexpo (niri has its own overview: Super+Z), opacity toggle,
// hyprdisplays / refresh-toggle / mirror-toggle / hdmi-wake (all hyprctl),
// AGS dashboard (Astal Hyprland bindings), blur (niri has none).

input {
    keyboard {
        xkb { layout "us"; }
        numlock
        repeat-delay 300
        repeat-rate 40
    }
    touchpad {
        tap
        // natural-scroll off, as in hypr/look.lua
    }
    mouse {
        accel-profile "flat"
    }
    // follow_mouse = 1 + cursor:warp_on_change_workspace = 1 in Hyprland.
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
    workspace-auto-back-and-forth
}

// ── Outputs ─────────────────────────────────────────────────────────────
// Same layout as lua/monitors.lua (VG27V main at 0x0, VY279HGR to its right).
// Matched by connector because that is what every script assumes; niri also
// accepts "Make Model Serial" strings — see `niri msg outputs` — if the
// connectors ever move. VG27V stays at 120Hz: 165 is link-marginal (hdmi-wake).
output "HDMI-A-1" {
    mode "1920x1080@120"
    position x=0 y=0
    scale 1
}
output "DP-2" {
    mode "1920x1080@100"
    position x=1920 y=0
    scale 1
}

// ── Layout ──────────────────────────────────────────────────────────────
layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // Hyprland-style border instead of niri's focus ring (gold→rose gradient
    // from look.lua, inactive blue-grey).
    focus-ring { off; }
    border {
        width 3
        active-gradient from="#f5a623" to="#e875a1" angle=45
        inactive-color "#6b8caebb"
        urgent-color "#d4848c"
    }
    shadow {
        on
        softness 15
        spread 3
        offset x=0 y=0
        color "#e8a85450"
    }
    struts { }
}

// ── Named workspaces ────────────────────────────────────────────────────
// Stand-in for Hyprland's special:magic scratchpad: Super+S bounces to/from
// it (workspace-auto-back-and-forth), Super+Shift+S sends a column there.
workspace "scratch"

// ── Environment (applies at start, like hypr/env.lua) ───────────────────
environment {
    XCURSOR_SIZE "24"
    XCURSOR_THEME "Bibata-Modern-Classic"
    // (NVIDIA env — LIBVA_DRIVER_NAME etc. — is set per-host in NixOS:
    // hosts/slanka/default.nix environment.sessionVariables.)
    // Keep SDL from grabbing the GC adapter away from Slippi (see env.lua)
    SDL_JOYSTICK_HIDAPI_GAMECUBE "0"
}

// niri spawns xwayland-satellite itself (needs it on PATH — configuration.nix)
// and exports DISPLAY to clients.
xwayland-satellite { }

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y%m%d_%H%M%S.png"
hotkey-overlay { skip-at-startup; }

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

// ── Autostart (hypr/autostart.lua minus the Hyprland-only bits) ─────────
// niri-session runs under systemd and activates graphical-session.target, so
// units bound to it start on their own; these two are started explicitly in
// the Hyprland config and are kept that way here for parity.
spawn-at-startup "systemctl" "--user" "start" "polkit-gnome-agent.service"
spawn-at-startup "systemctl" "--user" "start" "hyprwhspr-rs.service"
spawn-at-startup "nm-applet"
spawn-at-startup "waybar" "-c" "~/.config/waybar/config-niri.jsonc"
spawn-at-startup "mako"
spawn-at-startup "swww-daemon"
spawn-at-startup "hypridle"
spawn-sh-at-startup "wl-paste --watch cliphist store"
spawn-sh-at-startup "sleep 5 && while true; do ~/.config/hypr/scripts/wallpaper.sh random; sleep 300; done"
spawn-sh-at-startup "sleep 3 && ~/.config/hypr/scripts/led-ctl.sh apply"
spawn-sh-at-startup "~/.config/hypr/scripts/battery-monitor.sh"
spawn-sh-at-startup "rm -f /tmp/wobpipe && mkfifo /tmp/wobpipe && tail -f /tmp/wobpipe | wob"

// ── Window rules (hypr/rules.lua) ───────────────────────────────────────
// Rounded corners for everything (decoration:rounding = 12).
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 400; }
}
window-rule {
    match title="^(Open File|Save File|Open Folder)$"
    open-floating true
}
// Slippi Dolphin (melee bot sessions) + rwing: float, never size (see rules.lua)
window-rule {
    match app-id="^Apprun$"
    match app-id="^(rwing|rwing-linux-.*)$"
    open-floating true
}
window-rule {
    match app-id="^hyprdisplays$"
    open-floating true
}
// Pyprland-style dropdown terminals, if launched by hand: float + translucent
window-rule {
    match app-id="^kitty-(dropterm|cava|yazi)$"
    open-floating true
    opacity 0.9
}
window-rule {
    match app-id="^code$"
    open-on-workspace "3"
}

// ── Binds ───────────────────────────────────────────────────────────────
// Mod = Super. Kept as close to hypr/binds.lua as niri's model allows:
// column = Hyprland "window", workspace N = Nth workspace on THIS monitor
// (hyprsplit semantics for free), Super+, / Super+. = monitor left/right.
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Basics
    Mod+Q hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+C { close-window; }
    Mod+Escape hotkey-overlay-title="Power menu" { spawn "wlogout" "-b" "4"; }
    Mod+Shift+Ctrl+M hotkey-overlay-title="Emergency exit" { quit skip-confirmation=true; }
    Mod+E hotkey-overlay-title="Files" { spawn "dolphin"; }
    Mod+A hotkey-overlay-title="Claude Code" { spawn "kitty" "--class" "claude-code" "--title" "Claude Code" "-e" "claude"; }
    XF86Assistant hotkey-overlay-title=null { spawn "kitty" "--class" "claude-code" "--title" "Claude Code" "-e" "claude"; }
    Mod+T hotkey-overlay-title="btop" { spawn "kitty" "-e" "btop"; }
    Mod+B hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Mod+R hotkey-overlay-title="Launcher: rofi" { spawn-sh "pkill rofi || rofi -show drun"; }
    Mod+O hotkey-overlay-title="Launcher: walker" { spawn "walker"; }
    Mod+Shift+G hotkey-overlay-title="Stock Dolphin emulator" { spawn-sh "nix run nixpkgs#dolphin-emu"; }
    Mod+D hotkey-overlay-title="AGS dashboard (Hyprland only)" { spawn "ags" "toggle" "dashboard"; }

    // Layout
    Mod+V { toggle-window-floating; }
    Mod+Ctrl+V { switch-focus-between-floating-and-tiling; }
    Mod+F { fullscreen-window; }
    F11 { fullscreen-window; }
    Mod+Ctrl+F { maximize-column; }
    Mod+J { switch-preset-column-width; }
    Mod+P { switch-preset-window-height; }
    Mod+Ctrl+P { reset-window-height; }
    Mod+Shift+Space { center-column; }
    Mod+Z repeat=false { toggle-overview; }

    // Columns: consume/expel (niri's answer to dwindle splits)
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Groups (tabs) → tabbed column
    Mod+G { toggle-column-tabbed-display; }
    Mod+Tab { focus-window-down; }
    Mod+Shift+Tab { focus-window-up; }
    Mod+Ctrl+G { expel-window-from-column; }
    Alt+Tab { focus-window-previous; }

    // Focus / move / resize with arrows
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Ctrl+Left  { set-column-width "-50"; }
    Mod+Ctrl+Right { set-column-width "+50"; }
    Mod+Ctrl+Up    { set-window-height "-50"; }
    Mod+Ctrl+Down  { set-window-height "+50"; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // Workspaces (Nth on the focused monitor)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    // Scratchpad stand-in (named workspace, see above)
    Mod+S { focus-workspace "scratch"; }
    Mod+Shift+S { move-column-to-workspace "scratch"; }

    // Cross-monitor
    Mod+Comma  { focus-monitor-left; }
    Mod+Period { focus-monitor-right; }
    Mod+Shift+Comma  { move-column-to-monitor-left; }
    Mod+Shift+Period { move-column-to-monitor-right; }
    Mod+Ctrl+Comma   { move-workspace-to-monitor-right; }

    // Screenshots (grim/slurp/satty as in Hyprland; niri's own UI on Ctrl+Print)
    F9 hotkey-overlay-title="Screenshot region → clipboard + file" { spawn-sh "grim -g \"$(slurp)\" - | tee ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png | wl-copy"; }
    Shift+F9 hotkey-overlay-title="Screenshot region → satty" { spawn-sh "grim -g \"$(slurp)\" - | satty --filename - --output-filename ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png --copy-command wl-copy"; }
    Print hotkey-overlay-title="Screenshot full" { spawn-sh "grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png && wl-copy < ~/Pictures/Screenshots/$(ls -t ~/Pictures/Screenshots | head -1)"; }
    Ctrl+Print { screenshot; }
    Alt+Print { screenshot-window; }
    Mod+Shift+C hotkey-overlay-title="Color picker" { spawn "hyprpicker" "-a"; }

    // Clipboard / emoji
    F10 hotkey-overlay-title="Clipboard history" { spawn-sh "cliphist list | wofi --dmenu | cliphist decode | wl-copy"; }
    Mod+Ctrl+E hotkey-overlay-title="Emoji picker" { spawn "rofimoji" "--action" "type" "--typer" "wtype"; }

    // Dictation (hyprwhspr-rs owns the keys via evdev; this only narrates)
    F12 hotkey-overlay-title="Dictation toggle" { spawn "~/.config/hypr/scripts/dictation.sh"; }
    Mod+Space hotkey-overlay-title="Dictation push-to-talk" { spawn "~/.config/hypr/scripts/dictation.sh"; }

    Mod+Shift+V hotkey-overlay-title="Screen record toggle" { spawn "~/.config/ags/scripts/screen-record-toggle.sh"; }
    Mod+Shift+R hotkey-overlay-title="Validate config" { spawn-sh "niri validate && notify-send niri 'Config OK (auto-reloaded)' || notify-send -u critical niri \"$(niri validate 2>&1 | tail -20)\""; }
    Mod+F5 hotkey-overlay-title="Toggle idle/sleep" { spawn-sh "pkill hypridle && notify-send Hypridle 'Sleep disabled - staying awake' || { hypridle & notify-send Hypridle 'Sleep re-enabled'; }"; }
    Mod+L hotkey-overlay-title="Lock" { spawn "~/.config/hypr/scripts/lock-wrapper.sh"; }

    // Hardware / misc scripts that don't depend on hyprctl
    Mod+Shift+L hotkey-overlay-title="LEDs toggle" { spawn "~/.config/hypr/scripts/led-ctl.sh" "toggle"; }
    Mod+Ctrl+L  hotkey-overlay-title="LEDs menu" { spawn "~/.config/hypr/scripts/led-ctl.sh" "menu"; }
    Mod+Shift+D hotkey-overlay-title="Do not disturb" { spawn "~/.config/hypr/scripts/dnd-toggle.sh"; }
    Mod+Shift+K hotkey-overlay-title="Discord recover" { spawn "~/.config/hypr/scripts/discord-recover.sh"; }
    Mod+N hotkey-overlay-title="Restore notification" { spawn "makoctl" "restore"; }
    Mod+Shift+N hotkey-overlay-title="Notification picker" { spawn "notification-picker"; }
    Mod+W hotkey-overlay-title="Wallpaper picker" { spawn "~/.config/hypr/scripts/wallpaper.sh" "picker"; }
    Mod+Shift+W hotkey-overlay-title="Random wallpaper" { spawn "~/.config/hypr/scripts/wallpaper.sh" "random"; }
    Mod+F6 hotkey-overlay-title="Power profile toggle" { spawn "~/.config/hypr/scripts/power-profile.sh" "toggle"; }
    Mod+Shift+F6 hotkey-overlay-title="Power profile menu" { spawn "~/.config/hypr/scripts/power-profile.sh" "rofi"; }
    Mod+Semicolon hotkey-overlay-title="Keyboard mouse" { spawn "wl-kbptr"; }
    Mod+Shift+P { power-off-monitors; }

    // Volume (wob pipe), media keys
    // Super+Up/Down are window focus here (Hyprland double-bound them with volume).
    Mod+Equal allow-when-locked=true hotkey-overlay-title="Volume up" { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\\n\", $2*100}' > /tmp/wobpipe"; }
    Mod+Minus allow-when-locked=true hotkey-overlay-title="Volume down" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\\n\", $2*100}' > /tmp/wobpipe"; }
    Mod+M hotkey-overlay-title="Mute" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\\n\", $2*100}' > /tmp/wobpipe"; }
    Mod+Ctrl+M hotkey-overlay-title="Mute mic" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\\n\", $2*100}' > /tmp/wobpipe"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\\n\", $2*100}' > /tmp/wobpipe"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\\n\", $2*100}' > /tmp/wobpipe"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%+ && brightnessctl -m | awk -F, '{print substr($4, 0, length($4)-1)}' > /tmp/wobpipe"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%- && brightnessctl -m | awk -F, '{print substr($4, 0, length($4)-1)}' > /tmp/wobpipe"; }

    // Session save/restore + keybind cheatsheet (Hyprland scripts; may need porting)
    Mod+Ctrl+S { spawn "~/.config/hypr/scripts/session-picker.sh" "save"; }
    Mod+Ctrl+R { spawn "~/.config/hypr/scripts/session-picker.sh" "restore"; }

    // Mouse drag: niri handles Mod+LMB move / Mod+RMB resize natively.
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
}
